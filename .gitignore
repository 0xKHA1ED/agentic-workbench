# Host-repo sandboxes only — not part of ai-workflow package
projects/
sandbox/

# Local Python / tooling
__pycache__/
*.py[cod]
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
.worktrees/
references/

# Pending tree mutations (propose → human apply)
*.yaml.proposed

# Workflow runner session state (<project>/workflow/<node>.json)
# Do not ignore meta/workflows/ — those are committed YAML definitions.
**/workflow/*.json

# Install-kit checksum (regenerated by scripts/install.py)
.skills-manifest.json

# Runner feature-dir pointer; scope contracts stay as specs/*.md
**/specs/*/feature.json

# Local Python
__pycache__/
*.py[cod]
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Pending tree mutations (propose → human apply)
*.yaml.proposed

# Workflow runner session state (meta/workflow/<node>.json)
# meta/workflows/*.yaml definitions stay tracked.
**/workflow/*.json

# Install-kit checksum (regenerated by scripts/install.py)
.skills-manifest.json

# Runner feature-dir pointer; scope contracts stay as specs/*.md
**/specs/*/feature.json

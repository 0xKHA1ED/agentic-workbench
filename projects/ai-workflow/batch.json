    {"op": "add-group", "args": ["root", "pain-review-spec", "Pain: review specs"]},
    {"op": "add-child", "args": ["pain-review-spec", "review-slow", "Review still takes too long", "work", "empty"]},
    {"op": "add-child", "args": ["pain-review-spec", "approve-unclear", "Unclear approve vs fix — no fast binary gate", "work", "empty"]},

    {"op": "add-group", "args": ["root", "desired", "Desired behavior (target state)"]},
    {"op": "add-child", "args": ["desired", "say-harden-x", "Say 'harden cement certificates' → AI navigates domain map", "work", "discussing"]},
    {"op": "add-child", "args": ["desired", "pick-aspect", "Pick aspect (e.g. validation layer) from tree, not from memory", "work", "discussing"]},
    {"op": "add-child", "args": ["desired", "spec-factory", "AI drafts specs; I approve/reject in seconds each", "work", "discussing"]},
    {"op": "add-child", "args": ["desired", "deterministic-done", "Every spec has falsifiable VERIFY — agent executes flawlessly", "work", "discussing"]},

    {"op": "add-group", "args": ["root", "tooling", "Tooling (this repo)"]},
    {"op": "add-child", "args": ["tooling", "project-tree-skill", "project-tree — persistent map + weak signals", "work", "spec_ready"]},
    {"op": "add-child", "args": ["tooling", "scope-contract-skill", "scope-contract — fast spec format + review", "work", "spec_ready"]},

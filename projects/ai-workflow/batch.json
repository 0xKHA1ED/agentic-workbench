    {"op": "add-child", "args": ["daily-loop", "understand", "Do I understand the problem?", "work", "weak"]},
    {"op": "add-child", "args": ["daily-loop", "write-spec", "Write specs fast enough to cover the whole project", "work", "weak"]},
    {"op": "add-child", "args": ["daily-loop", "review-spec", "Review specs in seconds, not hours", "work", "weak"]},
    {"op": "add-child", "args": ["daily-loop", "implement", "Agent implements against approved spec", "work", "empty"]},

    {"op": "add-group", "args": ["root", "pain-orient", "Pain: orient (what to work on)"]},
    {"op": "add-child", "args": ["pain-orient", "no-mental-model", "No domain map when session starts", "work", "empty"]},
    {"op": "add-child", "args": ["pain-orient", "no-weak-signal", "Can't see which areas are weak or stale", "work", "empty"]},
    {"op": "add-child", "args": ["pain-orient", "too-many-tasks", "Too many possible tasks, no prioritization", "work", "empty"]},

    {"op": "add-group", "args": ["root", "pain-understand", "Pain: understand (investigate weak nodes)"]},
    {"op": "add-child", "args": ["pain-understand", "why-weak-unclear", "Weak node exists but why it's weak is unknown", "work", "empty"]},
    {"op": "add-child", "args": ["pain-understand", "investigation-adhoc", "Investigation is ad-hoc, not a repeatable ritual", "work", "empty"]},
    {"op": "add-child", "args": ["pain-understand", "domain-not-in-tree", "Domain knowledge lives in head, not in tree", "work", "empty"]},

    {"op": "add-group", "args": ["root", "pain-write-spec", "Pain: write specs (the bottleneck)"]},
    {"op": "add-child", "args": ["pain-write-spec", "cant-enumerate-verify", "Can't think of all VERIFY criteria agent needs", "work", "empty"]},
    {"op": "add-child", "args": ["pain-write-spec", "spec-too-slow", "Spec step eats the day — no time for other modules", "work", "empty"]},
    {"op": "add-child", "args": ["pain-write-spec", "spec-too-prose", "Specs drift into essays instead of done-criteria", "work", "empty"]},
